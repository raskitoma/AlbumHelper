# Port where the application will be exposed on the host
PORT=3000

# Folder path on the host machine where the database and backups will be stored
DB_DIR=./data

# Internal Database URL (used by Prisma inside the container)
DATABASE_URL=file:/app/data/figuritas.db

# Docker network to connect to (e.g. for reverse proxies like Nginx Proxy Manager)
DOCKER_NETWORK=album_network

# Name of the Docker container
CONTAINER_NAME=album-helper

# Public URL where users reach the app: scheme + host, no path (e.g. https://album.example.com).
# Used to build the links in password-reset and group-invite emails and the logout redirect.
# Required behind a reverse proxy; if empty, those links point at http://localhost:3000.
APP_URL=

